PORT=3000

# Google Sheets (opcional para executar localmente sem sincronizacao)
# Cole a URL completa da planilha Google neste campo
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/10DGHdXR-2F27NEv1NzaH26w_mWnmNZvsJniTKBC8qCg/edit
# Caminho para o JSON da conta de servico
GOOGLE_APPLICATION_CREDENTIALS=./src/config/google-service-account.json
# Alternativa: JSON das credenciais em uma unica variavel
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
